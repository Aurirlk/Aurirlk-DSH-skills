{
  "name": "dsh-aurirlk-skills",
  "version": "0.3.0",
  "description": "Aurirlk 验证可用的 DSH（DeepSeek Harness）技能合集：每个技能一个目录，装上本包即注册全部技能。当前收录 9 个技能，包含 disk-butler（Windows 电脑管家：查清空间去向、按安全等级清理、Junction 透明迁移缓存、留档成本机档案）与 drawio（draw.io 图表生成 / 导出 / 布局体检）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "ATTRIBUTIONS.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "skills",
    "collection",
    "windows",
    "disk",
    "cleanup",
    "cache",
    "junction",
    "drawio",
    "draw.io",
    "diagram",
    "architecture-diagram",
    "电脑管家",
    "磁盘清理",
    "图表"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
